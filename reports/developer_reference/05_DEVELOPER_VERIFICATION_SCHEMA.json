{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "YuE2-on-ROCm developer verification receipt",
 "type": "object",
 "required": ["schema", "generated_at_utc", "run_dir", "mode", "checks", "problems", "verdict"],
 "properties": {
  "schema": {"const": "yue2-rc6-developer-verification/1"},
  "generated_at_utc": {"type": "string"},
  "run_dir": {"type": "string"},
  "mode": {"enum": ["single_song", "campaign"]},
  "checks": {
   "type": "object",
   "properties": {
    "audio_wav": {"type": "object", "description": "path, samplerate(=48000), channels(=2), frames, seconds, finite, rms, non_silent, is_48k_stereo, file_sha256"},
    "audio_flac": {"type": "object"},
    "model_identity": {"type": "object", "properties": {"mot_sha256": {"type": "string"}, "vae_sha256": {"type": "string"}, "matches_pinned": {"type": "boolean"}}},
    "generation_config": {"type": "object", "properties": {"matches_reference": {"type": "boolean"}, "diffs": {"type": "object"}}},
    "candidate_coverage": {"type": "object", "properties": {"journal_results": {"type": "integer"}, "complete": {"type": "integer"}, "unique_ids": {"type": "integer"}, "duplicates": {"type": "integer"}, "expect_384": {"type": "boolean"}}},
    "runtime_identity": {"type": "object", "properties": {"sglang_commit": {"type": "string"}, "yue2_runtime_sha256": {"type": "string"}, "matches_pinned": {"type": "boolean"}}},
    "gpu_identity": {"type": "object", "properties": {"arch": {"type": "string"}, "name": {"type": "string"}, "bdf": {"type": "string"}, "uuid": {"type": "string"}, "stack_status": {"type": "string"}}},
    "performance_receipt": {"type": "object", "properties": {"n": {"type": "integer"}, "p50_wall_s": {"type": "number"}, "mean_wall_s": {"type": "number"}, "reference_p50_wall_s": {"type": "number"}, "measurement_scope": {"type": "string"}}},
    "audio_sample_audit": {"type": "object", "properties": {"sampled": {"type": "integer"}, "passed": {"type": "integer"}}}
   }
  },
  "problems": {"type": "array", "items": {"type": "string"}},
  "verdict": {"enum": ["VERIFIED_REFERENCE_RUN", "VERIFIED_WITH_DISCLOSED_DIFFERENCES", "VALID_PILOT_ONLY", "UNSUPPORTED_CONFIGURATION", "INCOMPLETE", "FAILED"]},
  "known_limitations_attached": {"type": "array", "items": {"type": "string"}},
  "verdict_vocabulary": {"type": "array", "items": {"type": "string"}},
  "reference_comparison": {"type": "object"}
 },
 "additionalProperties": false,
 "_semantics": {
  "VERIFIED_REFERENCE_RUN": "identity chain + config + audio integrity + coverage all match the frozen reference (single song or full 384 campaign)",
  "VERIFIED_WITH_DISCLOSED_DIFFERENCES": "audio valid and GPU-executed but config/model identity differ from the pinned reference (disclosed, not silently passed)",
  "VALID_PILOT_ONLY": "pilot-scale evidence (fewer than 384 candidates); NEVER comparable with the full scoreboard",
  "UNSUPPORTED_CONFIGURATION": "hardware/software stack outside the physically verified matrix (e.g. non-gfx1100 GPU without verification)",
  "INCOMPLETE": "artifacts missing; run unfinished",
  "FAILED": "one or more verification checks failed",
  "score_proximity_rule": "score proximity to official numbers NEVER grants VERIFIED by itself"
 }
}
