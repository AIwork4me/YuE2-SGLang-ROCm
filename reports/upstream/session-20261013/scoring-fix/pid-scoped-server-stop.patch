+# PID-scoped stop: only signal the generation server owned by THIS run.
+# Primary: the run's server.pid artifact (written by serve_yue2_gfx1100.sh).
+# Fallback: match this run's exact port, then verify this run's model path.
+SERVER_PID=""
+if [ -f "$RUNS/server.pid" ]; then
+  SERVER_PID=$(cat "$RUNS/server.pid" 2>/dev/null || true)
+fi
+if [ -z "$SERVER_PID" ] || ! kill -0 "$SERVER_PID" 2>/dev/null; then
+  SERVER_PID=$(pgrep -f "sglang serve .*--port 31000" | head -n 1 || true)
+fi
+if [ -n "$SERVER_PID" ] && kill -0 "$SERVER_PID" 2>/dev/null; then
+  if tr '\0' ' ' < "/proc/$SERVER_PID/cmdline" | grep -q "YuE2-3B"; then
+    kill -INT "$SERVER_PID" 2>/dev/null || true
+    for i in $(seq 1 24); do
+      kill -0 "$SERVER_PID" 2>/dev/null || break
+      sleep 5
+    done
+    if kill -0 "$SERVER_PID" 2>/dev/null; then
+      kill "$SERVER_PID" 2>/dev/null || true
+    fi
+    log "generation server stopped (PID-scoped SIGINT, then cleanup): $SERVER_PID"
+  else
+    log "REFUSED to signal PID $SERVER_PID: cmdline does not match this run's YuE2-3B server"
+  fi
+else
+  log "no run-owned generation server found; nothing to stop"
 fi
 sleep 10
 
